# ==============================================================================
# Superstore Data Pipeline Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Kaggle API Authentication
# ------------------------------------------------------------------------------
# To obtain credentials:
# 1. Go to https://www.kaggle.com/settings/account
# 2. Click "Create New Token" under the API section to download kaggle.json
# 3. Enter your username and key below, or place kaggle.json in ~/.kaggle/
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
KAGGLE_DATASET=bravehart101/sample-superstore-dataset

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Connection
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=superstore_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Database Schemas
POSTGRES_SCHEMA_RAW=raw
POSTGRES_SCHEMA_STAGING=staging
POSTGRES_SCHEMA_SILVER=silver
POSTGRES_SCHEMA_GOLD=gold

# ------------------------------------------------------------------------------
# 3. Pipeline Paths & Logging
# ------------------------------------------------------------------------------
RAW_DATA_PATH=data/raw/superstore.csv
ERRORS_DATA_PATH=data/errors/
PROCESSED_DATA_PATH=data/processed/
LOG_LEVEL=INFO
